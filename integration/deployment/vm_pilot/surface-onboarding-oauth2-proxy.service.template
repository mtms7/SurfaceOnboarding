# REVIEW ARTIFACT - not installed; needs approvals per docs/40 section 7.
# Template only. Do not install or enable before docs/40 section 7 steps 1-3 (placement, OneLogin app, certificate)
# are approved. Install path (after approval): /etc/systemd/system/surface-onboarding-oauth2-proxy.service
[Unit]
Description=oauth2-proxy for the Surface onboarding dashboard (VM team-access pilot)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/oauth2-proxy/oauth2-proxy.cfg

[Service]
Type=exec
# Own non-login user: shares no user, file, certificate or environment with workato-agent or the dashboard.
User=oauth2-proxy
Group=oauth2-proxy
UMask=0077
# Binary path and version are fixed by VM/SecOps (checksum recorded outside the repo).
ExecStart=/opt/oauth2-proxy/oauth2-proxy --config=/etc/oauth2-proxy/oauth2-proxy.cfg
Restart=on-failure
RestartSec=5

ReadOnlyPaths=/etc/oauth2-proxy

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Needs outbound HTTPS to OneLogin for the OIDC exchange: that egress must be named in the SecOps approval.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

MemoryMax=256M
CPUQuota=50%
TasksMax=128
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
