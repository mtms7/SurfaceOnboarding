# REVIEW ARTIFACT - not installed; see surface-onboarding-redash-collect.service.template.
# ACTIVE DIRECTION 2026-10-15 (owner): the VM must run without the owner's computer, so it collects the production clone itself (supersedes the 2026-10-14 DEFERRED note).
# Still gated: a read-only Redash key issued by the Redash owner (docs/44 section 3), the operator-created approval marker, and SecOps' outbound allow-list. Nothing runs until then.
# Install path (after approval): /etc/systemd/system/surface-onboarding-redash-collect.timer ; then: systemctl enable --now <this timer>.
[Unit]
Description=Surface onboarding: refresh the production clone from Redash hourly (clone is trusted up to 6 hours)

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h
RandomizedDelaySec=120
AccuracySec=1min
Unit=surface-onboarding-redash-collect.service

[Install]
WantedBy=timers.target
