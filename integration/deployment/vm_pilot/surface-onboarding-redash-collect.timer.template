# REVIEW ARTIFACT - not installed; see surface-onboarding-redash-collect.service.template.
# Install path (after approval): /etc/systemd/system/surface-onboarding-redash-collect.timer ; then: systemctl enable --now <this timer>.
[Unit]
Description=Surface onboarding: refresh the production clone from Redash hourly (clone is trusted up to 6 hours)

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h
RandomizedDelaySec=120
AccuracySec=1min
Unit=surface-onboarding-redash-collect.service

[Install]
WantedBy=timers.target
