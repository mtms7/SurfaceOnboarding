# REVIEW ARTIFACT - not installed; needs approvals per docs/40 section 7.
# oauth2-proxy configuration template (TOML) for the VM team-access pilot. PLACEHOLDERS ONLY: every <ANGLE_BRACKET>
# value comes from the OneLogin admin / SecOps after approval. No client credential, cookie key, or certificate
# is stored in this file; the two key values are read from root-owned files outside the repository.
# Install path (after approval): /etc/oauth2-proxy/oauth2-proxy.cfg  (mode 0640 root:oauth2-proxy)

http_address  = "127.0.0.1:4180"          # loopback only; never exposed
reverse_proxy = true                       # trust X-Forwarded-* from the local nginx only
upstreams     = [ "http://127.0.0.1:8000" ]   # the dashboard (loopback bind, unchanged)
pass_host_header = true                    # dashboard checks Host == public host:port

# OneLogin (OIDC). MFA is enforced by the OneLogin policy attached to this app, not by this proxy.
provider        = "oidc"
oidc_issuer_url = "https://<ONELOGIN_SUBDOMAIN>.onelogin.com/oidc/2"
client_id       = "<ONELOGIN_OIDC_CLIENT_ID>"
client_secret_file = "/etc/oauth2-proxy/client-secret.value"   # placeholder path; file created by Identity admin, mode 0400
redirect_url    = "https://172.26.37.20:8443/oauth2/callback"
scope           = "openid email profile"
code_challenge_method = "S256"
oidc_email_claim = "email"
insecure_oidc_allow_unverified_email = false
skip_provider_button = true

# Deny by default: only the e-mails listed in the allow-list file may sign in (one per line).
# The dashboard enforces its own allow-list and roles as well (SURFACE_ONBOARDING_ALLOWED_USERS / _OPERATORS).
email_domains = []
authenticated_emails_file = "/etc/oauth2-proxy/allowed-emails.txt"

# Identity passed to the dashboard: X-Forwarded-Email (the dashboard trusts it only from a loopback peer).
pass_user_headers          = true
pass_authorization_header  = false
pass_access_token          = false
set_xauthrequest           = false
prefer_email_to_user       = true

# Session cookie: Secure, HttpOnly, aligned with the 12 h dashboard session.
cookie_name     = "_surface_onboarding_sso"
cookie_secret_file = "/etc/oauth2-proxy/cookie-key.value"      # placeholder path; 32 random bytes (base64), mode 0400
cookie_secure   = true
cookie_httponly = true
cookie_samesite = "lax"                    # lax is required for the OIDC redirect back to /oauth2/callback
cookie_expire   = "12h"
cookie_refresh  = "1h"

# Sign-out: https://172.26.37.20:8443/oauth2/sign_out (linked from the dashboard menu in VM mode).
silence_ping_logging = true
standard_logging     = true
request_logging      = false               # never log request URLs/headers with identity data
